# Runtime-uploaded messaging attachments
/storage/message_attachments/*
!/storage/message_attachments/.gitkeep

# Local database backups / exports
/database/backups/*
/storage/backups/*
!/storage/backups/.gitkeep
*.sql.gz
*.sql.zip

# Runtime/debug logs
/storage/logs/*
!/storage/logs/.gitkeep
/storage/avatar_debug.log

# Hosting-local secrets (never commit real credentials)
/config/hosting.php
